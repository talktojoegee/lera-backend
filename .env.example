APP_NAME="Kogi State Land Use Charge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billing_system_main
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RoutePay QR (bill PDF) — GenerateCustomizedQRDynamicPaymentLink
ROUTEPAY_QR_ENABLED=false
# Must be API host (see RoutePay guide §3). Never use https://routepay.com — that returns HTML.
ROUTEPAY_BASE_URL=https://apiqa.routepay.com
ROUTEPAY_AUTH_URL=https://authqa.routepay.com/connect/token
ROUTEPAY_CLIENT_ID=
ROUTEPAY_CLIENT_SECRET=
# PNG under public/, or absolute path — e.g. assets/images/log.png
ROUTEPAY_MERCHANT_LOGO_PATH=
ROUTEPAY_QR_RETURN_URL="${APP_URL}"
ROUTEPAY_QR_DURATION_SECONDS=259200
ROUTEPAY_QR_VERIFY_ME=true

# Optional: exact POST URL from RoutePay if auto-detection hits HTML on apiqa (see laravel.log attempted_urls)
# ROUTEPAY_QR_GENERATE_URL=https://paymentqa.routepay.com/payment/api/v1/QRCode/GenerateCustomizedQRDynamicPaymentLink
# ROUTEPAY_QR_ALTERNATE_BASE_URLS=https://paymentqa.routepay.com

# Optional: QR only if RoutePay fails — must be a public https URL (not localhost). Uses QuickChart.
# Example: https://your-frontend.example/pay?assessment={assessment_no}&amt={amount}
BILL_PAYMENT_QR_FALLBACK_URL=
