APP_NAME="Kogi State Land Use Charge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billing_system_main
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bill PDF QR — links to Odoo payment page (assessment number in URL). No RoutePay API call per bill.
BILL_PAYMENT_QR_URL=https://lera.odoo.com/payment?assessment={assessment_no}
BILL_PAYMENT_QR_SIZE=180
# Legacy alias (optional override)
BILL_PAYMENT_QR_FALLBACK_URL=

# RoutePay QR (bill PDF) — disabled; use BILL_PAYMENT_QR_URL instead
ROUTEPAY_QR_ENABLED=false
# Must be API host (see RoutePay guide §3). Never use https://routepay.com — that returns HTML.
ROUTEPAY_BASE_URL=https://apiqa.routepay.com
ROUTEPAY_AUTH_URL=https://authqa.routepay.com/connect/token
ROUTEPAY_CLIENT_ID=
ROUTEPAY_CLIENT_SECRET=
# PNG under public/, or absolute path — e.g. assets/images/log.png
ROUTEPAY_MERCHANT_LOGO_PATH=
# Public URL of the Angular app (RoutePay returnUrl after payment — REQUIRED on production)
# Production example: https://kgirs-billing.kslas.ng
FRONTEND_URL=http://localhost:4200
ROUTEPAY_QR_RETURN_URL=
ROUTEPAY_QR_DURATION_SECONDS=259200
ROUTEPAY_QR_VERIFY_ME=false

# Webhook — register in RoutePay merchant portal: {APP_URL}/api/routepay/webhook
# Events delivered as ?event=payment (also credit, debit, payout, settlement)
ROUTEPAY_WEBHOOK_TIMESTAMP_TOLERANCE=300

# Optional: exact POST URL from RoutePay if auto-detection hits HTML on apiqa (see laravel.log attempted_urls)
# ROUTEPAY_QR_GENERATE_URL=https://paymentqa.routepay.com/payment/api/v1/QRCode/GenerateCustomizedQRDynamicPaymentLink
# ROUTEPAY_QR_ALTERNATE_BASE_URLS=https://paymentqa.routepay.com
